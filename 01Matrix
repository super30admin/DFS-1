class Solution {
    //TC o(mn) SC O(mn)
    public int[][] updateMatrix(int[][] mat) {

        int m=mat.length;
        int n=mat[0].length;
        Queue<int[]> q=new LinkedList<>();
        int[][] dirs=new int[][]{{-1,0},{1,0},{0,1},{0,-1}};

        for(int r=0;r<m;r++){
            for(int c=0;c<n;c++){
                if(mat[r][c]==0){
                    q.add(new int[] {r,c});
                }else{
                    mat[r][c]=-1;
                }

            }
        }
        while(!q.isEmpty()){
            int[] curr=q.poll();
            for(int[] dir:dirs)
            
            {
                int nr=curr[0]+dir[0];
                int nc=curr[1]+dir[1];
              
                if(nr>=0 && nr<m && nc>=0 && nc<n && mat[nr][nc]==-1){
                    mat[nr][nc]=mat[curr[0]][curr[1]]+1;
                    q.add(new int[] {nr,nc});

                }
            }

        }
        return mat;
    }
}
